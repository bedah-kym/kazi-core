# Kazi Core — Environment Variables
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Required for production. Dev defaults shown where safe.

# ─── Django ────────────────────────────────────────────────────────────────────
# Dev (DEBUG=1): leave blank — a stable key is generated and persisted to
#   Backend/.dev_secret_key automatically.
# Production: MUST set a unique value:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mathia_user
POSTGRES_PASSWORD=mathia_password
POSTGRES_DB=mathia_db
DATABASE_URL=postgres://mathia_user:mathia_password@db:5432/mathia_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── LLM — set at least one key ───────────────────────────────────────────────
# Option A: Anthropic (recommended, best reasoning)
ANTHROPIC_API_KEY=
# Option B: DeepSeek (good balance of cost/quality)
DEEPSEEK_API_KEY=
# Option C: Hugging Face (free tier available)
HF_API_TOKEN=

# ─── Encryption ────────────────────────────────────────────────────────────────
# Room encryption keys in the DB depend on this value. If it changes after rooms
# exist, those rooms become undecryptable on restart (WebSocket 403).
# Dev (DEBUG=1): leave blank — a stable key is generated and persisted to
#   Backend/.encryption.key automatically.
# Production: MUST set a stable value:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Timezone ──────────────────────────────────────────────────────────────────
TZ=UTC

# ─── Optional: Connector API keys ─────────────────────────────────────────────
OPENWEATHER_API_KEY=
GIPHY_API_KEY=
EXCHANGE_RATE_API_KEY=

# ─── Optional: Temporal (disabled for local dev) ──────────────────────────────
TEMPORAL_DISABLED=1

# ─── Optional: Governed shell sidecar (v0.6) ──────────────────────────────────
# `run_command` runs one command in a sandboxed container via a separate
# sidecar process (`python Backend/manage.py run_shell_exec`). Leave the token
# blank to disable run_command entirely. The token is a single revocable
# bearer token shared between Kazi and the sidecar.
SHELL_EXEC_TOKEN=
SHELL_EXEC_HOST=127.0.0.1
SHELL_EXEC_PORT=8765
SHELL_EXEC_PROFILE=standard
# Comma-separated profiles the sidecar may serve. Default: just the profile
# above. Add `open` only on a disposable box — it runs unsandboxed on the host.
SHELL_EXEC_PROFILES=standard
SHELL_EXEC_IMAGE=alpine:3.20
SHELL_EXEC_TIMEOUT_DEFAULT=120
SHELL_EXEC_TIMEOUT_MAX=600
SHELL_EXEC_OUTPUT_BYTES_MAX=65536
SHELL_EXEC_NETWORK_ALLOWLIST=

