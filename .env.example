# Kazi Core — Environment Variables
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Required for production. Dev defaults shown where safe.

# ─── Django ────────────────────────────────────────────────────────────────────
# Generate a real key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-real-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mathia_user
POSTGRES_PASSWORD=mathia_password
POSTGRES_DB=mathia_db
DATABASE_URL=postgres://mathia_user:mathia_password@db:5432/mathia_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── LLM — set at least one key ───────────────────────────────────────────────
# Option A: Anthropic (recommended, best reasoning)
ANTHROPIC_API_KEY=
# Option B: DeepSeek (good balance of cost/quality)
DEEPSEEK_API_KEY=
# Option C: Hugging Face (free tier available)
HF_API_TOKEN=

# ─── Encryption ────────────────────────────────────────────────────────────────
# REQUIRED. Room encryption keys in the DB depend on this value. If it changes
# (or is left blank), existing rooms become undecryptable on restart (WebSocket 403).
# The value below is a valid dev placeholder — REPLACE IT in production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=qOPLueT6R2EpXXlhXOsihVAdAZpHBwNSxr4kKtLErC0=

# ─── Timezone ──────────────────────────────────────────────────────────────────
TZ=UTC

# ─── Optional: Connector API keys ─────────────────────────────────────────────
OPENWEATHER_API_KEY=
GIPHY_API_KEY=
EXCHANGE_RATE_API_KEY=

# ─── Optional: Temporal (disabled for local dev) ──────────────────────────────
TEMPORAL_DISABLED=1
